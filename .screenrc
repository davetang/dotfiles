term screen-256color
truecolor on
status top right

bufferfile $HOME/.screen-exchange
bindkey -m > eval "stuff ' '" writebuf "exec $HOME/bin/sendcb $HOME/.screen-exchange"

screen -t nvim 0 zsh
screen -t work 1 zsh
screen -t glances 2 zsh
screen -t etc 3 zsh
screen -t etc2 4 zsh
screen -t etc3 5 zsh
screen -t etc4 6 zsh
select 0
